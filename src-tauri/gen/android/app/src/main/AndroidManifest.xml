<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- M4 保活：前台服务 + 通知（Android 13+ 运行时请求 POST_NOTIFICATIONS） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- M6 系统能力：定位（第一批）。
         ACCESS_COARSE_LOCATION 是 Android 12+ 的强制兼容项：只声明 FINE
         时，系统弹窗会忽略「仅大致位置」选项，用户拒绝精确定位后就彻底没有
         位置可用。两个都声明才能让用户在两种精度间选择。 -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- M6 1b：日历（读写分开申请，便于「只看不写」用法与最小权限说明） -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!--
      M6 后续批次在此追加（落地时同步开对应能力，不提前声明无关权限）：
      · 1b 通讯录：READ_CONTACTS（只看不写，不申请 WRITE_CONTACTS）
      · 1b 照片：READ_MEDIA_IMAGES（Android 13+）/
        READ_EXTERNAL_STORAGE（maxSdkVersion=32）
      · 2 提醒事项：SCHEDULE_EXACT_ALARM / USE_EXACT_ALARM
      · 2 蓝牙：BLUETOOTH_SCAN / BLUETOOTH_CONNECT（API 31+）
      · 4 无障碍：BIND_ACCESSIBILITY_SERVICE（属受限制权限，见
        docs/PROGRESS.md 的安全模型讨论）
    -->

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.pi_mobile"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- OAuth 辅助回调通道：pimobile://oauth/callback?... （deep-link 插件
                 转发进 bundle 的 __pi_oauth_callback，见 src-tauri/src/oauth.rs） -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="pimobile" android:host="oauth" android:pathPrefix="/callback" />
            </intent-filter>
        </activity>

        <!-- M4 保活：agent 运行期前台服务（Rust 经 JNI start/notify/stop） -->
        <service
            android:name=".ForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
