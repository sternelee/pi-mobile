<?xml version="1.0" encoding="utf-8"?>
<!--
  pi-native 的 Android 权限声明。

  ACCESS_COARSE_LOCATION 必须与 FINE 一起声明：只声明 FINE 时，Android 12+
  的系统弹窗会略过「仅大致位置」选项，用户一旦拒绝精确定位就彻底没有位置
  可用；两个都声明才能让用户在两种精度间选择（且本插件的 provider 选择逻辑
  会在拿不到 GPS 时落到 network）。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- 日历：读与写分开申请，便于「只看不写」的用法（以及 Play 审核时的
         最小权限说明）。 -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!-- 通讯录：只申请读权限。本插件不写通讯录 —— agent 修改用户联系人的
         风险与收益严重不对称（误删不可逆），且没有产品需求。 -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- 相册：Android 13 起为细粒度媒体权限；旧的 READ_EXTERNAL_STORAGE 带
         maxSdkVersion=32，否则新系统上会多出一个用户看不懂的权限请求。
         只读 —— 不写回相册（那在分区存储下要另走 MediaStore insert）。 -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
</manifest>
