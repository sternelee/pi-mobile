# Cargo 构建产物。根 .gitignore 与 src-tauri/.gitignore 都只匹配自己的
# /target/，覆盖不到插件目录 —— 早期因此把 2426 个产物文件提交进了仓库
# （516 MB），已重写历史清除。
/target/

# build.rs 从 tauri crate 拷进来的 API 源码（iOS Swift 包 / Android 模块）。
# 每次构建都会重新拷贝，不是本仓的源码。
/.tauri/
/android/.tauri/

# 由 build.rs 生成（命令权限与 schema），随 COMMANDS 变化自动重建。
/permissions/autogenerated/
/permissions/schemas

# 独立构建插件时生成的锁文件/解析结果；应用级的是 src-tauri/Cargo.lock
/Cargo.lock
/ios/Package.resolved
